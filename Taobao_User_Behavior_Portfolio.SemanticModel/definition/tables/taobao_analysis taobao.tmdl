table 'taobao_analysis taobao'
	lineageTag: 7ad8bbdb-9339-4b76-abaf-72519336bfc7

	measure 'PV Users' =
			
			CALCULATE(
			    DISTINCTCOUNT('taobao_analysis taobao'[user_id]),
			    'taobao_analysis taobao'[behavior] = "pv"
			)
		formatString: 0
		lineageTag: 6f06cd04-582c-455b-a127-74b2e4d832fc

	measure 'Cart Users' =
			CALCULATE(
			    DISTINCTCOUNT('taobao_analysis taobao'[user_id]),
			    'taobao_analysis taobao'[behavior] = "cart"
			)
		formatString: 0
		lineageTag: eae9eef7-e69b-48d8-89ed-5023573ab4bb

	measure 'Buy Users' =
			CALCULATE(
			    DISTINCTCOUNT('taobao_analysis taobao'[user_id]),
			    'taobao_analysis taobao'[behavior] = "buy"
			)
		formatString: 0
		lineageTag: 94897b37-f7ae-440f-bef8-7181eb853a40

	measure 'Active Users' = DISTINCTCOUNT('taobao_analysis taobao'[user_id])
		formatString: 0
		lineageTag: 7ab0f6e8-c8bc-4bb7-9d3b-fa0a2f2f4ecd

	measure 用户数 = DISTINCTCOUNT('taobao_analysis taobao'[user_id])
		formatString: 0
		lineageTag: 6541cf41-47d1-4ff9-b882-f8eb7138d1ba

	measure 页面浏览量 = CALCULATE(COUNTROWS('taobao_analysis taobao'), 'taobao_analysis taobao'[behavior] = "pv")
		formatString: 0
		lineageTag: 1ad367d6-8597-4390-89b7-cfc7dadee22f

	measure 购买转化率 = DIVIDE([Buy Users], [PV Users], 0)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 2ef07382-2af8-4641-aa95-04ada413f888

	measure PV/UV = DIVIDE([页面浏览量], [用户数], 0)
		lineageTag: 6855af0c-9246-48e5-a35c-82229edd26f5

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 高频购买用户（行为代理） = COUNTROWS(FILTER(VALUES('taobao_analysis taobao'[user_id]), CALCULATE(COUNTROWS('taobao_analysis taobao'), 'taobao_analysis taobao'[behavior] = "buy") >= 2))
		formatString: 0
		lineageTag: 19582a40-2f82-4ad9-8197-5be3d8c311d8

	column user_id
		dataType: int64
		formatString: 0
