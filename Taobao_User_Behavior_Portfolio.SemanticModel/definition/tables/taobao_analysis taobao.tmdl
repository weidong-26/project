	partition 'taobao_analysis taobao' = m
		mode: import
		source =
				let
				    源 = MySQL.Database("localhost", "taobao_analysis", [ReturnSingleDatabase=true]),
				    taobao_analysis_taobao = 源{[Schema="taobao_analysis",Item="taobao"]}[Data],
				    已添加自定义 = Table.AddColumn(taobao_analysis_taobao, "datetime自定义", each #datetime(1970,1,1,0,0,0)
				+ #duration(0,0,0,[timestamp])
				+ #duration(0,8,0,0)),
				    更改的类型 = Table.TransformColumnTypes(已添加自定义,{{"datetime自定义", type datetime}}),
				    重命名的列 = Table.RenameColumns(更改的类型,{{"datetime自定义", "datetime"}}),
				    已添加自定义1 = Table.AddColumn(重命名的列, "date", each Date.From([datetime])),
				    更改的类型1 = Table.TransformColumnTypes(已添加自定义1,{{"date", type datetime}}),
				    已添加自定义2 = Table.AddColumn(更改的类型1, "hour", each Time.Hour(Time.From([datetime]))),
				    已添加自定义3 = Table.AddColumn(已添加自定义2, "weekday", each Date.DayOfWeekName(Date.From([datetime]), "zh-CN")),
				    更改的类型2 = Table.TransformColumnTypes(已添加自定义3,{{"hour", Int64.Type}, {"weekday", type text}})
				in
				    更改的类型2

